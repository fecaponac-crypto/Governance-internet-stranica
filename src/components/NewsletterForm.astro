---
import { SITE } from '../data/site';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['nl', { compact }]} aria-labelledby="nl-title">
  <p class="eyebrow">The Monday Signal</p>
  <h2 id="nl-title">The week in data governance, in five minutes.</h2>
  <p class="lede">The most important developments, why they matter and who should act, plus the editor’s column — every Monday. No noise.</p>
  <form class="nl-form" action={SITE.newsletterSubscribeUrl} method="post" target="_blank" data-nl-form>
    <label class="visually-hidden" for={compact ? 'nl-email-c' : 'nl-email'}>Email address</label>
    <input id={compact ? 'nl-email-c' : 'nl-email'} type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
    <input type="hidden" name="embed" value="1" />
    <button class="btn" type="submit">Subscribe</button>
  </form>
  <p class="note" data-nl-note role="status">
    Free. Confirm by email, unsubscribe anytime, no tracking. <a href="/privacy/">Privacy</a>
  </p>
</section>

<script>
  // The form opens Buttondown's confirmation page in a new tab; tell the reader what happens next.
  document.querySelectorAll<HTMLFormElement>('[data-nl-form]').forEach((form) => {
    form.addEventListener('submit', () => {
      const note = form.parentElement?.querySelector('[data-nl-note]');
      if (note) note.textContent = 'Almost done — check your inbox and click the confirmation link.';
    });
  });
</script>

<style>
  .nl {
    background: var(--paper-2);
    border-top: 3px solid var(--signal);
    padding: 1.5rem;
    border-radius: 0 0 8px 8px;
  }
  h2 {
    font-size: 1.45rem;
    margin: 0.4rem 0 0.5rem;
  }
  .lede {
    color: var(--ink-2);
  }
  .nl-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  input {
    flex: 1 1 200px;
    min-width: 0;
    font: inherit;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
  }
  .note {
    font-size: 0.8rem;
    color: var(--ink-3);
    margin: 0.6rem 0 0;
  }
  .compact h2 {
    font-size: 1.2rem;
  }
</style>
