---
import Importance from './Importance.astro';
import { categoryById } from '../data/site';
import { articleUrl, formatDate, isoDate, type Article } from '../utils/articles';
import { cardUrl, CARD_WIDTH, CARD_HEIGHT } from '../utils/card';

interface Props {
  article: Article;
  variant?: 'lead' | 'stack' | 'default' | 'compact';
}
const { article, variant = 'default' } = Astro.props;
const { data } = article;
const primary = categoryById(data.categories[0]);
const Heading = variant === 'lead' ? 'h2' : 'h3';
---

<article class:list={['card', variant]}>
  {
    variant !== 'compact' && (
      <a class="thumb" href={articleUrl(article)} tabindex="-1" aria-hidden="true">
        <img
          src={cardUrl(article)}
          width={CARD_WIDTH}
          height={CARD_HEIGHT}
          alt=""
          loading={variant === 'lead' ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    )
  }
  <div class="top">
    <a class="eyebrow" href={`/category/${primary.id}/`}>{primary.short}</a>
    <Importance level={data.importance} showLabel={variant !== 'compact'} />
  </div>
  <Heading class="title"><a href={articleUrl(article)}>{data.title}</a></Heading>
  {variant !== 'compact' && <p class="dek">{data.dek}</p>}
  {
    variant === 'lead' && (
      <div class="why">
        <p class="eyebrow">Why it matters</p>
        <p>{data.whyItMatters}</p>
      </div>
    )
  }
  <p class="meta">
    <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
    <span aria-hidden="true"> · </span>{data.type}
    {data.region && <><span aria-hidden="true"> · </span>{data.region}</>}
  </p>
</article>

<style>
  .card {
    padding: 0 0 1.4rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.4rem;
  }
  .thumb {
    display: block;
    margin-bottom: 0.9rem;
  }
  .thumb img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .default {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    column-gap: 1.25rem;
  }
  .default > :not(.thumb) {
    grid-column: 1;
  }
  .default .thumb {
    grid-column: 2;
    grid-row: 1 / span 4;
    margin: 0.2rem 0 0;
  }
  @media (max-width: 520px) {
    .default {
      grid-template-columns: minmax(0, 1fr) 104px;
      column-gap: 0.9rem;
    }
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }
  .eyebrow {
    text-decoration: none;
  }
  .title {
    font-size: 1.3rem;
    margin-bottom: 0.45rem;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--signal);
  }
  .dek {
    color: var(--ink-2);
    margin-bottom: 0.55rem;
  }
  .meta {
    margin: 0;
  }
  .lead .title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.12;
    margin-bottom: 0.75rem;
  }
  .lead .dek {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.5;
  }
  .why {
    border-left: 3px solid var(--signal);
    background: var(--paper-2);
    padding: 0.9rem 1.1rem;
    margin: 0 0 0.9rem;
    border-radius: 0 8px 8px 0;
  }
  .why p {
    margin: 0;
    color: var(--ink);
  }
  .why .eyebrow {
    margin-bottom: 0.35rem;
  }
  .compact .title {
    font-size: 1.05rem;
  }
  .compact {
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
</style>
