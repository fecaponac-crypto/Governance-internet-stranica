---
import Base from '../layouts/Base.astro';
import { ENFORCEMENT_ACTIONS, ENFORCEMENT_FRAMEWORKS, SITE } from '../data/site';
import { articleUrl, enforcementCases, enforcementTotals, formatAmount, formatDate, getArticles, isoDate } from '../utils/articles';

const cases = enforcementCases(await getArticles());
const count = (key: 'framework' | 'action', value: string) => cases.filter((c) => c.latest.e[key] === value).length;
const frameworks = ENFORCEMENT_FRAMEWORKS.filter((f) => count('framework', f));
const actions = ENFORCEMENT_ACTIONS.filter((a) => count('action', a));
const open = cases.filter((c) => c.status === 'Open').length;
const withAmount = cases.filter((c) => c.amount).length;
const totals = enforcementTotals(cases);
// The step that carries the amount (a settlement stays the reference after a later court step).
const amountStep = (c: (typeof cases)[number]) => [...c.steps].reverse().find((s) => s.e.amount && s.e.currency) ?? c.latest;
const breakdowns = [
  { title: 'By law', head: 'Law', rows: totals.byLaw },
  { title: 'By country', head: 'Country', rows: totals.byCountry },
  { title: `By ${totals.periodLabel.toLowerCase()}`, head: totals.periodLabel, rows: totals.byPeriod },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Data protection and AI enforcement tracker',
  description: 'Fines, settlements, court rulings, orders, investigations and complaints in data protection, privacy and AI regulation, followed as cases and linked to their sources.',
  url: `${SITE.url}/enforcement/`,
  creator: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  dateModified: cases[0] ? isoDate(cases[0].latest.e.date) : undefined,
};
---

<Base
  title="Enforcement tracker: data protection and AI fines and decisions"
  description="Every GDPR, AI Act and privacy fine, settlement, ruling and investigation we cover — authority, company, amount and law, with links to the sources."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Tracker</p>
      <h1>Enforcement tracker</h1>
      <p>
        Fines, settlements, court rulings, orders, investigations and complaints in data protection, privacy and AI
        regulation — who acted, against whom, how much and under which law. Each matter is followed as a case, from complaint
        or investigation to decision and appeal, and every step links to our coverage and its sources. Complaints and
        investigations are not findings.
      </p>
    </header>

    <section class="stats" aria-label="Summary">
      <div><b>{cases.length}</b><span>cases followed</span></div>
      <div><b>{open}</b><span>still open</span></div>
      <div><b>{withAmount}</b><span>with a stated amount</span></div>
    </section>

    <section class="numbers" aria-labelledby="numbers-title">
      <h2 id="numbers-title">The tracker in numbers</h2>
      <div class="grid">
        {
          breakdowns.map((b) => (
            <table class="mini">
              <caption>{b.title}</caption>
              <thead>
                <tr>
                  <th scope="col">{b.head}</th>
                  <th scope="col" class="num">Cases</th>
                  <th scope="col" class="num">Open</th>
                  <th scope="col" class="num">Stated amounts</th>
                </tr>
              </thead>
              <tbody>
                {b.rows.map((g) => (
                  <tr>
                    <th scope="row">{g.label}</th>
                    <td class="num">{g.cases}</td>
                    <td class="num">{g.open}</td>
                    <td class="num sums">{g.amounts.length ? g.amounts.map((a) => <span>{formatAmount(a.amount, a.currency)}</span>) : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ))
        }
        {
          totals.largest.length > 0 && (
            <div class="largest">
              <h3>Largest stated amounts</h3>
              <ol>
                {totals.largest.map((c) => (
                  <li>
                    <b>{formatAmount(c.amount!.amount, c.amount!.currency)}</b>
                    <a href={`#${c.id}`}>{c.latest.e.parties}</a>
                    <span class="sub">
                      {amountStep(c).e.authority} · {amountStep(c).e.action}, case {c.status.toLowerCase()}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>
      <p class="caveat">
        Counts cover the cases we have reported, not every decision made. Amounts are added up per currency as stated in the
        sources and are not converted; they include jury verdicts and fines that can still be appealed or reduced.
      </p>
    </section>

    <form class="filters" data-filters aria-label="Filter the tracker">
      <label>
        Law
        <select name="framework">
          <option value="">All</option>
          {frameworks.map((f) => <option value={f}>{f} ({count('framework', f)})</option>)}
        </select>
      </label>
      <label>
        Latest action
        <select name="action">
          <option value="">All</option>
          {actions.map((a) => <option value={a}>{a} ({count('action', a)})</option>)}
        </select>
      </label>
      <label>
        Status
        <select name="status">
          <option value="">All</option>
          <option value="Open">Open ({open})</option>
          <option value="Closed">Closed ({cases.length - open})</option>
        </select>
      </label>
      <p class="shown" role="status" data-shown>{cases.length} shown</p>
    </form>

    <div class="table-wrap">
      <table>
        <caption class="visually-hidden">Enforcement cases, latest activity first</caption>
        <thead>
          <tr>
            <th scope="col">Latest</th>
            <th scope="col">Authority</th>
            <th scope="col">Against / concerning</th>
            <th scope="col">Stage</th>
            <th scope="col" class="num">Amount</th>
            <th scope="col">Law</th>
          </tr>
        </thead>
        <tbody>
          {
            cases.map((c) => {
              const e = c.latest.e;
              return (
                <tr data-framework={e.framework} data-action={e.action} data-status={c.status} id={c.id}>
                  <td data-label="Latest"><time datetime={isoDate(e.date)}>{formatDate(e.date)}</time></td>
                  <td data-label="Authority">
                    {e.authority}
                    <span class="sub">{e.jurisdiction}</span>
                  </td>
                  <td data-label="Against / concerning">
                    <a href={articleUrl(c.latest.article)}>{e.parties}</a>
                    {c.steps.length > 1 && (
                      <details class="timeline">
                        <summary>{c.steps.length} steps</summary>
                        <ol>
                          {c.steps.map((s) => (
                            <li>
                              <time datetime={isoDate(s.e.date)}>{formatDate(s.e.date)}</time> · {s.e.action}
                              {s.e.amount ? ` · ${formatAmount(s.e.amount, s.e.currency)}` : ''} ·{' '}
                              <a href={articleUrl(s.article)}>{s.e.authority}</a>
                            </li>
                          ))}
                        </ol>
                      </details>
                    )}
                  </td>
                  <td data-label="Stage">
                    <span class:list={['action', e.action.toLowerCase().replace(/\s+/g, '-')]}>{e.action}</span>
                    <span class:list={['status', c.status.toLowerCase()]}>{c.status}</span>
                  </td>
                  <td data-label="Amount" class="num">{c.amount ? formatAmount(c.amount.amount, c.amount.currency) : '—'}</td>
                  <td data-label="Law">
                    {e.law ?? '—'}
                    <span class="sub">{e.framework}</span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="prose notes">
      <h2>About this tracker</h2>
      <ul>
        <li>Built from the stories we publish, so it covers what our sources report and our editor approves; it is not an exhaustive register of every decision.</li>
        <li>Amounts are as stated in the sources, in the original currency. Settlements and court awards may be appealed or paid in instalments; see each story's status.</li>
        <li><b>Complaints</b> and <b>investigations</b> are claims or inquiries, not findings. Nothing in those rows has been decided.</li>
        <li>A case is <b>open</b> until it ends in a settlement or a decision the sources describe as final (for example, appeal waived); fines and rulings that can still be appealed stay open.</li>
        <li>Spotted a missing or wrong entry? <a href={`mailto:${SITE.email}?subject=Enforcement tracker`}>Tell us</a>. See also <a href="/institutions/">institutions</a> and <a href="/deadlines/">key dates</a>.</li>
      </ul>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-filters]').forEach((form) => {
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('.table-wrap tbody tr')];
    const shown = form.querySelector<HTMLElement>('[data-shown]')!;
    const apply = () => {
      const f = (form.elements.namedItem('framework') as HTMLSelectElement).value;
      const a = (form.elements.namedItem('action') as HTMLSelectElement).value;
      const st = (form.elements.namedItem('status') as HTMLSelectElement).value;
      let n = 0;
      rows.forEach((r) => {
        const on = (!f || r.dataset.framework === f) && (!a || r.dataset.action === a) && (!st || r.dataset.status === st);
        r.hidden = !on;
        n += on ? 1 : 0;
      });
      shown.textContent = `${n} shown`;
    };
    form.addEventListener('change', apply);
  });
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-bottom: 1.5rem;
  }
  .stats div {
    background: var(--paper);
    padding: 0.9rem 1rem;
  }
  .stats b {
    display: block;
    font-family: var(--serif);
    font-size: 1.7rem;
  }
  .stats span {
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .numbers {
    margin-bottom: 2rem;
  }
  .numbers h2 {
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }
  .numbers .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 1.5rem 2rem;
    align-items: start;
  }
  .mini {
    font-size: 0.88rem;
  }
  .mini caption,
  .largest h3 {
    text-align: left;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.3rem;
  }
  .mini th,
  .mini td {
    padding: 0.4rem 0.4rem;
  }
  .mini tbody th {
    text-transform: none;
    letter-spacing: 0;
    font-size: inherit;
    font-weight: 500;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .mini th.num {
    text-align: right;
  }
  .mini td.num {
    font-weight: 500;
  }
  .mini {
    width: 100%;
  }
  .sums span {
    display: block;
  }
  .largest ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    border-top: 2px solid var(--ink);
  }
  .largest li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .largest b {
    font-variant-numeric: tabular-nums;
  }
  .largest .sub {
    grid-column: 2;
  }
  .caveat {
    margin: 0.9rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-2);
    max-width: 60rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
  }
  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  select {
    font: inherit;
    font-size: 0.9rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.5rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .shown {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th {
    text-align: left;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-bottom: 2px solid var(--ink);
    padding: 0.5rem 0.6rem;
  }
  td {
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0.6rem;
  }
  tr[hidden] {
    display: none;
  }
  .num {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }
  time {
    white-space: nowrap;
  }
  .sub {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .action {
    font-size: 0.78rem;
    font-weight: 650;
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0.05rem 0.5rem;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .action.fine,
  .action.settlement,
  .action.court-ruling {
    color: var(--signal);
  }
  .status {
    display: block;
    width: fit-content;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .status.open::before {
    content: '● ';
    color: var(--signal);
  }
  .status.closed::before {
    content: '✓ ';
  }
  .timeline {
    margin-top: 0.4rem;
    font-size: 0.82rem;
  }
  .timeline summary {
    cursor: pointer;
    color: var(--ink-2);
    min-height: 24px;
  }
  .timeline ol {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
  }
  .timeline li {
    margin-bottom: 0.2rem;
  }
  .notes {
    margin-top: 2rem;
  }
  .notes h2 {
    font-size: 1.3rem;
  }
  .notes ul {
    padding-left: 1.2rem;
    font-size: 0.92rem;
  }
  /* Phones: each row becomes a card. */
  @media (max-width: 720px) {
    .table-wrap thead {
      display: none;
    }
    .table-wrap tr {
      display: block;
      border-bottom: 1px solid var(--rule);
      padding: 0.6rem 0;
    }
    .table-wrap td {
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      gap: 0.5rem;
      border: none;
      padding: 0.25rem 0;
    }
    .table-wrap td::before {
      content: attr(data-label);
      font-size: 0.75rem;
      font-weight: 650;
      color: var(--ink-2);
    }
    td .action {
      justify-self: start;
    }
    td > .sub,
    td > .status,
    td > .timeline {
      grid-column: 2;
      margin-top: -0.4rem;
    }
    .table-wrap .num {
      text-align: left;
    }
  }
</style>
