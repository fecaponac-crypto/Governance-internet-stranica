---
import Base from '../../layouts/Base.astro';
---

<Base title="Check your inbox" description="Confirm your subscription to The Monday Signal.">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="eyebrow">Almost done</p>
      <h1>Check your inbox.</h1>
      <p>
        We have sent you an email with a confirmation link. Click it to start receiving The Monday Signal. If it does
        not arrive within a few minutes, check your spam or promotions folder.
      </p>
    </header>
    <p><a class="btn" href="/">Back to the latest news</a></p>
  </div>
</Base>

<style>
  .narrow {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
</style>
