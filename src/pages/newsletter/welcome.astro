---
import Base from '../../layouts/Base.astro';
---

<Base title="Welcome" description="Your subscription to the Weekly Briefing is confirmed.">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="eyebrow">Subscription confirmed</p>
      <h1>Welcome to the Weekly Briefing.</h1>
      <p>
        Every Friday you will get the developments that matter for data governance — what happened, why it matters and
        who should act, with links to every source. You can unsubscribe from any email.
      </p>
    </header>
    <p><a class="btn" href="/">Read the latest news</a> &nbsp; <a href="/editorial-policy/">How we work</a></p>
  </div>
</Base>

<style>
  .narrow {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
</style>
