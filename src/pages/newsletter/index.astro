---
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---

<Base title="Newsletter" description="The Monday Signal: the week in data governance and the editor’s column, every Monday.">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="eyebrow">Newsletter</p>
      <h1>The Monday Signal</h1>
      <p>One email every Monday: the developments that mattered last week, what to do about them, and what comes next.</p>
    </header>
    <NewsletterForm />
    <div class="prose points">
      <ul>
        <li><b>The Big Signal</b> — the one development of the week that matters most, and why.</li>
        <li><b>Five Things That Matter</b> — the rest of the week, ranked, each with a link to the sources.</li>
        <li><b>Governance in Practice</b> — what it means for your processes, roles and controls.</li>
        <li><b>What to Watch</b> — deadlines, votes and predictions coming due.</li>
        <li><b>One Practical Insight</b> — from the editor's own work, plus the weekly column.</li>
        <li>No tracking pixels, no selling of addresses.</li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .narrow {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .points {
    margin-top: 2rem;
    font-size: 1.05rem;
  }
  .points ul {
    padding-left: 1.2rem;
  }
</style>
