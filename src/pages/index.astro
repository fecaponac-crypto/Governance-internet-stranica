---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { articleUrl, columnUrl, formatDate, getArticles, getColumns, getOpinions, getPredictions, isoDate, opinionUrl, pickLead } from '../utils/articles';
import { INSTITUTIONS } from '../data/institutions';
import { CATEGORIES, COLUMN, SITE } from '../data/site';

const articles = await getArticles();
const column = (await getColumns())[0];
const essay = (await getOpinions())[0];
// Lead story: importance weighed against age at build time (the site rebuilds at least daily).
const lead = pickLead(articles);
// Latest: every other article, newest first. The top right holds our own writing, so no
// news item appears twice and the newest story is always first under Latest (or the lead).
const others = articles.filter((a) => a !== lead);
const LATEST_COUNT = 12;
const latest = others.slice(0, LATEST_COUNT);
const top = column || essay ? [] : latest.slice(0, 2);

// Rail: our tools, filled from the published articles (the site rebuilds at least daily).
const now = Date.now();
const today = isoDate(new Date());
const upcoming = articles
  .flatMap((a) => a.data.deadlines.map((d) => ({ ...d, article: a })))
  .filter((d) => isoDate(d.date) >= today)
  .sort((x, y) => x.date.getTime() - y.date.getTime())
  .slice(0, 5);
const week = articles
  .filter((a) => a !== lead && now - a.data.date.getTime() <= 7 * 864e5)
  .sort((a, b) => b.data.importance - a.data.importance || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const monthArticles = articles.filter((a) => now - a.data.date.getTime() <= 30 * 864e5);
const activeInstitutions = INSTITUTIONS.map((i) => ({ ...i, n: monthArticles.filter((a) => a.data.institutions.includes(i.id)).length }))
  .filter((i) => i.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 5);
const openPredictions = (await getPredictions()).filter((p) => p.data.status === 'open');
const nextPrediction = openPredictions[0];
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.id, articles.filter((a) => a.data.categories.includes(c.id)).length]),
);
---

<Base>
  <div class="wrap">
    <h1 class="visually-hidden">{SITE.name}: what matters in data governance, and why</h1>
    <section class="hero" aria-label="Top stories">
      <div class="lead">{lead && <ArticleCard article={lead} variant="lead" />}</div>
      <div class="side">
        {
          column && (
            <section class="column" aria-labelledby="column-title">
              <p class="kicker" id="column-title">{COLUMN.name}</p>
              <a href={columnUrl(column)}>{column.data.title}</a>
              <p>{column.data.dek}</p>
              <p class="by">By {column.data.author} · <a href="/predictions/">Prediction tracker</a></p>
            </section>
          )
        }
        {
          essay && (
            <section class="column" aria-labelledby="opinion-title">
              <p class="kicker" id="opinion-title">Editor's Opinion</p>
              <a href={opinionUrl(essay)}>{essay.data.title}</a>
              <p>{essay.data.dek}</p>
              <p class="by">By {essay.data.author}</p>
            </section>
          )
        }
        {top.map((a) => <ArticleCard article={a} variant="stack" />)}
        <NewsletterForm compact />
      </div>
    </section>

    <div class="cols">
      <section aria-labelledby="latest-title">
        <div class="section-title">
          <h2 id="latest-title">Latest</h2>
          <a href="/search/">Search the archive</a>
        </div>
        {latest.map((a) => <ArticleCard article={a} />)}
        {others.length > LATEST_COUNT && <p class="all-news"><a href="/news/">All news ({articles.length}) →</a></p>}
      </section>

      <aside class="rail">
        {
          week.length > 0 && (
            <section class="box" aria-labelledby="week-title">
              <div class="section-title"><h2 id="week-title">This week's most important</h2></div>
              <ol class="mini">
                {week.map((a) => (
                  <li>
                    <a href={articleUrl(a)}>{a.data.title}</a>
                    <span>{a.data.importance >= 4 ? (a.data.importance === 5 ? 'Critical' : 'Important') : 'Notable'}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        {
          upcoming.length > 0 && (
            <section class="box" aria-labelledby="dates-title">
              <div class="section-title"><h2 id="dates-title">Key dates</h2><a href="/deadlines/">All</a></div>
              <ul class="mini dates">
                {upcoming.map((d) => (
                  <li>
                    <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
                    <a href={articleUrl(d.article)}>{d.what}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          activeInstitutions.length > 0 && (
            <section class="box" aria-labelledby="inst-title">
              <div class="section-title"><h2 id="inst-title">Most active this month</h2><a href="/institutions/">All</a></div>
              <ul class="mini counts">
                {activeInstitutions.map((i) => (
                  <li>
                    <a href={`/institutions/${i.id}/`}>{i.short}</a>
                    <span class="count">{i.n}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          openPredictions.length > 0 && (
            <section class="box" aria-labelledby="pred-title">
              <div class="section-title"><h2 id="pred-title">Predictions</h2><a href="/predictions/">Tracker</a></div>
              <p class="pred">
                <b>{openPredictions.length}</b> open, ours and others'. Next due {formatDate(nextPrediction!.data.due)}:
                {' '}{nextPrediction!.data.claim}
              </p>
            </section>
          )
        }
        <section class="topics" aria-labelledby="topics-title">
          <div class="section-title"><h2 id="topics-title">Topics</h2></div>
          <ul>
            {
              CATEGORIES.filter((c) => c.section === 'core').map((c) => (
                <li>
                  <a href={`/category/${c.id}/`}>{c.label}</a>
                  <span class="count">{counts[c.id]}</span>
                </li>
              ))
            }
            <li class="broad">
              <a href="/data-and-ai/">Data &amp; AI (broader coverage)</a>
            </li>
          </ul>
        </section>
        <section class="about">
          <div class="section-title"><h2>About</h2></div>
          <p>
            Data Governance Signal tracks regulators, standards bodies, researchers and vendors, and selects what matters
            for data governance professionals. Every item explains <em>why it matters</em> and links to its sources.
          </p>
          <p><a href="/methodology/">How we work</a></p>
        </section>
        <div class="sticky">
          {
            SITE.newsletter ? (
              <>
                <p>Get <b>The Monday Signal</b>: the week in data governance, every Monday.</p>
                <a class="btn" href="/newsletter/">Subscribe</a>
              </>
            ) : (
              <>
                <p>Tips, corrections or questions? <b>Write to the editor.</b></p>
                <a class="btn" href={`mailto:${SITE.email}`}>Contact</a>
              </>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.25rem 0 1rem;
  }
  .lead :global(.card) {
    border-bottom: none;
  }
  .side {
    border-left: 1px solid var(--rule);
    padding-left: 2rem;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 1rem;
  }
  .rail {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .topics ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topics li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.93rem;
  }
  .topics a {
    text-decoration: none;
  }
  .count {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .topics .broad a {
    color: var(--ink-2);
  }
  .about p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  @media (max-width: 860px) {
    .hero,
    .cols {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .side {
      border-left: none;
      padding-left: 0;
    }
    .hero {
      padding-top: 1.5rem;
    }
    .rail {
      margin-top: 1rem;
    }
  }
  /* Our own writing (The Monday Signal, Editor's Opinion): same treatment as "Why it matters". */
  .column {
    background: var(--paper-2);
    border-left: 4px solid var(--signal);
    border-radius: 0 8px 8px 0;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.25rem;
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    margin: 0 0 0.5rem !important;
  }
  .column > a {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }
  .column > a:hover {
    text-decoration: underline;
  }
  .column p {
    margin: 0.4rem 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .column .by {
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .mini {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mini li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.93rem;
    line-height: 1.35;
  }
  .mini a {
    text-decoration: none;
    color: var(--ink);
  }
  .mini a:hover {
    text-decoration: underline;
  }
  .mini li span {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-top: 0.15rem;
  }
  .mini.dates time {
    display: block;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--signal);
  }
  .mini.counts li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .mini.counts .count {
    display: inline;
    margin: 0;
  }
  .pred {
    font-size: 0.93rem;
    color: var(--ink-2);
    margin: 0;
  }
  .all-news {
    margin: 1.5rem 0 0;
    font-weight: 600;
  }
  .sticky {
    position: sticky;
    top: 1.25rem;
    background: var(--paper-2);
    border-left: 4px solid var(--signal);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem;
  }
  .sticky p {
    margin: 0 0 0.75rem;
    font-size: 0.93rem;
  }
</style>
