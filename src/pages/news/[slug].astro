---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Importance from '../../components/Importance.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import Feedback from '../../components/Feedback.astro';
import Listen from '../../components/Listen.astro';
import { categoryById, SITE, STATUS_STAGES } from '../../data/site';
import { institutionById } from '../../data/institutions';
import { enforcementCases, getArticles, getLegislation, formatAmount, formatDate, isoDate, type Article } from '../../utils/articles';
import { cardUrl, cardAbsoluteUrl, CARD_WIDTH, CARD_HEIGHT } from '../../utils/card';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, all: articles } }));
}

interface Props {
  article: Article;
  all: Article[];
}
const { article, all } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const cats = data.categories.map(categoryById);
const institutions = data.institutions.map(institutionById);
const official = data.sources.some((s) => s.primary);
const enfCase = data.enforcement ? enforcementCases(all).find((c) => c.steps.some((s) => s.article.id === article.id)) : undefined;
const corrections = await getCollection('corrections', (c) => c.data.article === article.id);
const laws = data.legislation.length ? (await getLegislation(all)).filter((l) => data.legislation.includes(l.file.id)) : [];

// Related stories by how closely they connect: picked by the writer, same law, same enforcement case,
// same institution, then shared topics; newer first among equals.
const caseIds = new Set(enfCase ? enfCase.steps.map((st) => st.article.id) : []);
const relevance = (a: Article) =>
  (data.related.includes(a.id) ? 8 : 0) +
  (a.data.legislation.some((l) => data.legislation.includes(l)) ? 5 : 0) +
  (caseIds.has(a.id) ? 5 : 0) +
  (a.data.institutions.some((i) => data.institutions.includes(i)) ? 3 : 0) +
  a.data.categories.filter((c) => data.categories.includes(c)).length;
const related = all
  .filter((a) => a.id !== article.id)
  .map((a) => ({ a, score: relevance(a) }))
  .filter((x) => x.score > 0)
  .sort((x, y) => y.score - x.score || y.a.data.date.getTime() - x.a.data.date.getTime())
  .slice(0, 3)
  .map((x) => x.a);
// The newest stories not already shown, for readers arriving from search.
const latest = all.filter((a) => a.id !== article.id && !related.includes(a)).slice(0, 4);
// Where to follow this story next.
const follow = [
  ...laws.map((l) => ({ href: `/legislation/${l.file.id}/`, label: `${l.file.data.short}: ${l.file.data.stage}`, kind: 'Legislation tracker' })),
  ...(enfCase ? [{ href: `/enforcement/#${enfCase.id}`, label: `${enfCase.latest.e.authority.split(' (')[0]} case (${enfCase.status.toLowerCase()})`, kind: 'Enforcement tracker' }] : []),
  ...institutions.map((i) => ({ href: `/institutions/${i.id}/`, label: i.short, kind: 'All news from' })),
  ...cats.slice(0, 2).map((c) => ({ href: `/category/${c.id}/`, label: c.label, kind: 'More in' })),
  ...(data.deadlines.length ? [{ href: '/deadlines/', label: 'Key dates', kind: 'Calendar' }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.dek,
  datePublished: isoDate(data.date),
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  isBasedOn: data.sources.map((s) => s.url),
  image: cardAbsoluteUrl(article),
  ...(institutions.length && { about: institutions.map((i) => ({ '@type': 'Organization', name: i.name, url: i.url })) }),
};
---

<Base title={data.title} description={data.dek} type="article" image={cardAbsoluteUrl(article)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="wrap" data-pagefind-body>
    <header class="head">
      <p class="eyebrow" data-pagefind-ignore>
        {cats.map((c, i) => <>{i > 0 && <span class="sep"> / </span>}<a href={`/category/${c.id}/`}>{c.short}</a></>)}
      </p>
      <h1>{data.title}</h1>
      <p class="dek">{data.dek}</p>
      <div class="facts" data-pagefind-ignore>
        <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        <span>{data.type}</span>
        {data.region && <span>{data.region}</span>}
        <Importance level={data.importance} />
        {
          data.status && (
            <a class="status" href="/methodology/#status" title={STATUS_STAGES[data.status.stage]}>
              {data.status.stage}
            </a>
          )
        }
        <span class:list={['basis', { secondary: !official }]}>
          {official ? 'Official source' : 'Secondary reporting'}
        </span>
      </div>
      <Listen parts="article h1, article p.dek, article .prose, article section.why, article section.check" />
    </header>

    <div class="layout">
      <div class="main">
        <figure class="hero" data-pagefind-ignore>
          <img src={cardUrl(article)} width={CARD_WIDTH} height={CARD_HEIGHT} alt={`${data.card?.figure ?? data.type}: ${data.card?.caption ?? data.dek}`} />
        </figure>
        {
          data.sample && (
            <p class="sample" data-pagefind-ignore>
              Sample article for the preview, written from the sources below.
            </p>
          )
        }
        <div class="prose">
          <Content />
        </div>

        <section class="why" aria-labelledby="why">
          <h2 id="why">Why it matters</h2>
          <p>{data.whyItMatters}</p>
        </section>

        {
          data.status?.detail && (
            <p class="status-line">
              <b>Status: {data.status.stage}.</b> {data.status.detail}
            </p>
          )
        }

        {
          data.whatToCheck.length > 0 && (
            <section class="check" aria-labelledby="check">
              <h2 id="check">What to check</h2>
              <ul>
                {data.whatToCheck.map((c) => <li>{c}</li>)}
              </ul>
            </section>
          )
        }

        {
          data.deadlines.length > 0 && (
            <section class="dates" aria-labelledby="dates">
              <h2 id="dates">Key dates</h2>
              <ul>
                {data.deadlines.map((d) => (
                  <li>
                    <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time> {d.what}
                  </li>
                ))}
              </ul>
              <p class="more"><a href="/deadlines/">All upcoming dates</a></p>
            </section>
          )
        }

        <section class="sources" aria-labelledby="src">
          <h2 id="src">Sources</h2>
          <ol>
            {
              data.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">
                    {s.title}
                  </a>
                  <span class="meta">
                    {' '}
                    — {s.name}
                    {s.primary && <span class="primary">Primary source</span>}
                  </span>
                </li>
              ))
            }
          </ol>
          {
            data.via && (
              <p class="via">
                Found via <a href={data.via.url} rel="noopener" target="_blank">{data.via.name}</a>
              </p>
            )
          }
        </section>

        <Feedback title={data.title} />
        {
          corrections.map((c) => (
            <p class="correction">
              <b>Correction, {formatDate(c.data.date)}:</b> {c.data.what}
            </p>
          ))
        }
        <p class="disclosure" data-pagefind-ignore>
          Prepared with AI assistance and reviewed by the editor before publication. Spotted an error? <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent('Correction: ' + data.title)}`}>Tell us</a
          > — see our <a href="/editorial-policy/">editorial policy</a> and <a href="/methodology/">methodology</a>.
        </p>
      </div>

      <div class="aside" data-pagefind-ignore>
        <section>
          <h2 class="label">Governance areas</h2>
          <ul class="chips">
            {cats.map((c) => <li><a href={`/category/${c.id}/`}>{c.label}</a></li>)}
          </ul>
        </section>
        {
          data.enforcement && (
            <section class="enf">
              <h2 class="label">Enforcement</h2>
              <dl>
                <dt>Action</dt>
                <dd>{data.enforcement.action}</dd>
                <dt>Authority</dt>
                <dd>{data.enforcement.authority}</dd>
                <dt>Concerning</dt>
                <dd>{data.enforcement.parties}</dd>
                {data.enforcement.amount && (
                  <>
                    <dt>Amount</dt>
                    <dd class="amount">{formatAmount(data.enforcement.amount, data.enforcement.currency)}</dd>
                  </>
                )}
                {data.enforcement.law && (
                  <>
                    <dt>Law</dt>
                    <dd>{data.enforcement.law}</dd>
                  </>
                )}
              </dl>
              {enfCase && (
                <p class="case">
                  Case status: <b>{enfCase.status}</b>
                  {enfCase.steps.length > 1 && <> · {enfCase.steps.length} steps</>}
                </p>
              )}
              <a href={`/enforcement/#${enfCase?.id ?? ''}`}>Enforcement tracker</a>
            </section>
          )
        }
        {
          laws.length > 0 && (
            <section>
              <h2 class="label">Legislation tracker</h2>
              <ul class="laws">
                {laws.map(({ file, stories }) => (
                  <li>
                    <a href={`/legislation/${file.id}/`}>{file.data.short}</a>
                    <span>
                      {file.data.stage} · {stories.length} {stories.length === 1 ? 'story' : 'stories'}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          institutions.length > 0 && (
            <section>
              <h2 class="label">Institutions</h2>
              <ul class="chips">
                {institutions.map((i) => <li><a href={`/institutions/${i.id}/`}>{i.short}</a></li>)}
              </ul>
            </section>
          )
        }
        <section>
          <h2 class="label">Who should care</h2>
          <ul class="roles">
            {data.whoShouldCare.map((r) => <li>{r}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </article>

  <div class="wrap after">
    <nav class="follow" aria-labelledby="follow-title">
      <h2 id="follow-title">Follow this story</h2>
      <ul>
        {
          follow.map((f) => (
            <li>
              <a href={f.href}>
                <span class="kind">{f.kind}</span>
                <span class="what">{f.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      related.length > 0 && (
        <section aria-labelledby="rel">
          <div class="section-title">
            <h2 id="rel">Related</h2>
          </div>
          <div class="rel-grid">
            {related.map((a) => (
              <ArticleCard article={a} variant="compact" />
            ))}
          </div>
        </section>
      )
    }
    {
      latest.length > 0 && (
        <section aria-labelledby="latest">
          <div class="section-title">
            <h2 id="latest">Latest</h2>
            <a href="/news/">All news</a>
          </div>
          <div class="rel-grid four">
            {latest.map((a) => (
              <ArticleCard article={a} variant="compact" />
            ))}
          </div>
        </section>
      )
    }
    <NewsletterForm />
  </div>
</Base>

<style>
  .head {
    max-width: 820px;
    padding: 2.5rem 0 1.5rem;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .sep {
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.9rem);
    line-height: 1.1;
    margin: 0.5rem 0 0.9rem;
  }
  .dek {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 260px);
    gap: 3.5rem;
    padding-top: 0.75rem;
  }
  .hero {
    margin: 0 0 1.5rem;
  }
  .hero img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .sample {
    font-size: 0.82rem;
    color: var(--ink-2);
    background: var(--signal-soft);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .why {
    border-left: 3px solid var(--signal);
    background: var(--paper-2);
    padding: 1.1rem 1.25rem;
    margin: 1.75rem 0;
    border-radius: 0 8px 8px 0;
  }
  .why h2,
  .sources h2,
  .label {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .why h2 {
    color: var(--signal);
  }
  .why p {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }
  .sources ol {
    margin: 0;
    padding-left: 1.2rem;
  }
  .sources li {
    margin-bottom: 0.55rem;
  }
  .via {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .primary {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: 0.7rem;
    font-weight: 650;
    color: var(--signal);
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0 0.45rem;
  }
  .disclosure {
    margin-top: 1.75rem;
    font-size: 0.82rem;
    color: var(--ink-3);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 0.25rem;
  }
  .aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips a {
    display: inline-block;
    font-size: 0.82rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    text-decoration: none;
  }
  .roles li {
    font-size: 0.92rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .after {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .rel-grid.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .follow {
    border-top: 3px solid var(--ink);
    padding-top: 0.9rem;
  }
  .follow h2 {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
  }
  .follow ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .follow a {
    display: flex;
    flex-direction: column;
    min-height: 44px;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    text-decoration: none;
    color: var(--ink);
  }
  .follow a:hover,
  .follow a:focus-visible {
    border-color: var(--signal);
  }
  .follow .kind {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .follow .what {
    font-weight: 650;
    font-size: 0.95rem;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .rel-grid,
    .rel-grid.four {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .head {
      padding-top: 1.75rem;
    }
  }
  .status,
  .basis {
    font-size: 0.75rem;
    font-weight: 650;
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0 0.5rem;
    text-decoration: none;
    color: var(--ink-2);
  }
  .basis {
    font-weight: 500;
    border-color: var(--rule);
  }
  .basis.secondary {
    color: var(--signal);
    border-color: currentColor;
  }
  .status-line {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .check,
  .dates {
    margin: 1.75rem 0;
  }
  .check h2,
  .dates h2 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .check ul,
  .dates ul {
    padding-left: 1.2rem;
    margin: 0;
  }
  .check li,
  .dates li {
    margin-bottom: 0.35rem;
  }
  .dates time {
    font-weight: 650;
    margin-right: 0.35rem;
  }
  .dates .more {
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .correction {
    font-size: 0.92rem;
    background: var(--signal-soft);
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
  }
  .enf dl {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
  }
  .enf dt {
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--ink-2);
    margin-top: 0.45rem;
  }
  .enf dd {
    margin: 0;
  }
  .enf .amount {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .enf > a {
    font-size: 0.85rem;
  }
  .enf .case {
    font-size: 0.85rem;
    margin: 0.2rem 0 0.4rem;
  }
  .laws {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .laws li {
    margin-bottom: 0.45rem;
  }
  .laws a {
    font-weight: 650;
  }
  .laws span {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
</style>
