---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Importance from '../../components/Importance.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { categoryById, SITE, STATUS_STAGES } from '../../data/site';
import { institutionById } from '../../data/institutions';
import { getArticles, formatDate, isoDate, type Article } from '../../utils/articles';
import { cardUrl, cardAbsoluteUrl, CARD_WIDTH, CARD_HEIGHT } from '../../utils/card';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, all: articles } }));
}

interface Props {
  article: Article;
  all: Article[];
}
const { article, all } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const cats = data.categories.map(categoryById);
const institutions = data.institutions.map(institutionById);
const official = data.sources.some((s) => s.primary);
const corrections = await getCollection('corrections', (c) => c.data.article === article.id);

// Explicit related items first, then others sharing a category.
const explicit = data.related.map((id) => all.find((a) => a.id === id)).filter((a): a is Article => !!a);
const shared = all.filter(
  (a) => a.id !== article.id && !explicit.includes(a) && a.data.categories.some((c) => data.categories.includes(c)),
);
const related = [...explicit, ...shared].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.dek,
  datePublished: isoDate(data.date),
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  isBasedOn: data.sources.map((s) => s.url),
  image: cardAbsoluteUrl(article),
  ...(institutions.length && { about: institutions.map((i) => ({ '@type': 'Organization', name: i.name, url: i.url })) }),
};
---

<Base title={data.title} description={data.dek} type="article" image={cardAbsoluteUrl(article)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="wrap" data-pagefind-body>
    <header class="head">
      <p class="eyebrow" data-pagefind-ignore>
        {cats.map((c, i) => <>{i > 0 && <span class="sep"> / </span>}<a href={`/category/${c.id}/`}>{c.short}</a></>)}
      </p>
      <h1>{data.title}</h1>
      <p class="dek">{data.dek}</p>
      <div class="facts" data-pagefind-ignore>
        <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        <span>{data.type}</span>
        {data.region && <span>{data.region}</span>}
        <Importance level={data.importance} />
        {
          data.status && (
            <a class="status" href="/methodology/#status" title={STATUS_STAGES[data.status.stage]}>
              {data.status.stage}
            </a>
          )
        }
        <span class:list={['basis', { secondary: !official }]}>
          {official ? 'Official source' : 'Secondary reporting'}
        </span>
      </div>
    </header>

    <div class="layout">
      <div class="main">
        <figure class="hero" data-pagefind-ignore>
          <img src={cardUrl(article)} width={CARD_WIDTH} height={CARD_HEIGHT} alt={`${data.card?.figure ?? data.type}: ${data.card?.caption ?? data.dek}`} />
        </figure>
        {
          data.sample && (
            <p class="sample" data-pagefind-ignore>
              Sample article for the preview, written from the sources below.
            </p>
          )
        }
        <div class="prose">
          <Content />
        </div>

        <section class="why" aria-labelledby="why">
          <h2 id="why">Why it matters</h2>
          <p>{data.whyItMatters}</p>
        </section>

        {
          data.status?.detail && (
            <p class="status-line">
              <b>Status: {data.status.stage}.</b> {data.status.detail}
            </p>
          )
        }

        {
          data.whatToCheck.length > 0 && (
            <section class="check" aria-labelledby="check">
              <h2 id="check">What to check</h2>
              <ul>
                {data.whatToCheck.map((c) => <li>{c}</li>)}
              </ul>
            </section>
          )
        }

        {
          data.deadlines.length > 0 && (
            <section class="dates" aria-labelledby="dates">
              <h2 id="dates">Key dates</h2>
              <ul>
                {data.deadlines.map((d) => (
                  <li>
                    <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time> {d.what}
                  </li>
                ))}
              </ul>
              <p class="more"><a href="/deadlines/">All upcoming dates</a></p>
            </section>
          )
        }

        <section class="sources" aria-labelledby="src">
          <h2 id="src">Sources</h2>
          <ol>
            {
              data.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">
                    {s.title}
                  </a>
                  <span class="meta">
                    {' '}
                    — {s.name}
                    {s.primary && <span class="primary">Primary source</span>}
                  </span>
                </li>
              ))
            }
          </ol>
          {
            data.via && (
              <p class="via">
                Found via <a href={data.via.url} rel="noopener" target="_blank">{data.via.name}</a>
              </p>
            )
          }
        </section>

        {
          corrections.map((c) => (
            <p class="correction">
              <b>Correction, {formatDate(c.data.date)}:</b> {c.data.what}
            </p>
          ))
        }
        <p class="disclosure" data-pagefind-ignore>
          Prepared with AI assistance and reviewed by the editor before publication. Spotted an error? <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent('Correction: ' + data.title)}`}>Tell us</a
          > — see our <a href="/editorial-policy/">editorial policy</a> and <a href="/methodology/">methodology</a>.
        </p>
      </div>

      <aside class="aside" data-pagefind-ignore>
        <section>
          <h2 class="label">Governance areas</h2>
          <ul class="chips">
            {cats.map((c) => <li><a href={`/category/${c.id}/`}>{c.label}</a></li>)}
          </ul>
        </section>
        {
          institutions.length > 0 && (
            <section>
              <h2 class="label">Institutions</h2>
              <ul class="chips">
                {institutions.map((i) => <li><a href={`/institutions/${i.id}/`}>{i.short}</a></li>)}
              </ul>
            </section>
          )
        }
        <section>
          <h2 class="label">Who should care</h2>
          <ul class="roles">
            {data.whoShouldCare.map((r) => <li>{r}</li>)}
          </ul>
        </section>
      </aside>
    </div>
  </article>

  <div class="wrap after">
    {
      related.length > 0 && (
        <section aria-labelledby="rel">
          <div class="section-title">
            <h2 id="rel">Related</h2>
          </div>
          <div class="rel-grid">
            {related.map((a) => (
              <ArticleCard article={a} variant="compact" />
            ))}
          </div>
        </section>
      )
    }
    <NewsletterForm />
  </div>
</Base>

<style>
  .head {
    max-width: 820px;
    padding: 2.5rem 0 1.5rem;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .sep {
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.9rem);
    line-height: 1.1;
    margin: 0.5rem 0 0.9rem;
  }
  .dek {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 260px);
    gap: 3.5rem;
    padding-top: 0.75rem;
  }
  .hero {
    margin: 0 0 1.5rem;
  }
  .hero img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .sample {
    font-size: 0.82rem;
    color: var(--ink-2);
    background: var(--signal-soft);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .why {
    border-left: 3px solid var(--signal);
    background: var(--paper-2);
    padding: 1.1rem 1.25rem;
    margin: 1.75rem 0;
    border-radius: 0 8px 8px 0;
  }
  .why h2,
  .sources h2,
  .label {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .why h2 {
    color: var(--signal);
  }
  .why p {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }
  .sources ol {
    margin: 0;
    padding-left: 1.2rem;
  }
  .sources li {
    margin-bottom: 0.55rem;
  }
  .via {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .primary {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: 0.7rem;
    font-weight: 650;
    color: var(--signal);
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0 0.45rem;
  }
  .disclosure {
    margin-top: 1.75rem;
    font-size: 0.82rem;
    color: var(--ink-3);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 0.25rem;
  }
  .aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips a {
    display: inline-block;
    font-size: 0.82rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    text-decoration: none;
  }
  .roles li {
    font-size: 0.92rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .after {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .rel-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .head {
      padding-top: 1.75rem;
    }
  }
  .status,
  .basis {
    font-size: 0.75rem;
    font-weight: 650;
    border: 1px solid currentColor;
    border-radius: 99px;
    padding: 0 0.5rem;
    text-decoration: none;
    color: var(--ink-2);
  }
  .basis {
    font-weight: 500;
    border-color: var(--rule);
  }
  .basis.secondary {
    color: var(--signal);
    border-color: currentColor;
  }
  .status-line {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .check,
  .dates {
    margin: 1.75rem 0;
  }
  .check h2,
  .dates h2 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .check ul,
  .dates ul {
    padding-left: 1.2rem;
    margin: 0;
  }
  .check li,
  .dates li {
    margin-bottom: 0.35rem;
  }
  .dates time {
    font-weight: 650;
    margin-right: 0.35rem;
  }
  .dates .more {
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }
  .correction {
    font-size: 0.92rem;
    background: var(--signal-soft);
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
  }
</style>
