---
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { COLUMN } from '../../data/site';
import { columnUrl, formatDate, getColumns } from '../../utils/articles';

const columns = await getColumns();
---

<Base
  title={COLUMN.name}
  description="The editor's weekly column: what last week meant for data governance, what comes next, and how earlier predictions turned out."
>
  <div class="wrap narrow">
    <header class="page-head">
      <p class="eyebrow">Every Monday</p>
      <h1>{COLUMN.name}</h1>
      <p>
        What last week meant for data governance, what we expect next — and a check on earlier predictions, ours and
        others’. Opinion, clearly labelled, from a practitioner. Tracked on the <a href="/predictions/">prediction tracker</a>.
      </p>
    </header>

    {
      columns.length ? (
        <ol class="list">
          {columns.map((c) => (
            <li>
              <time datetime={c.id}>{formatDate(c.data.date)}</time>
              <h2>
                <a href={columnUrl(c)}>{c.data.title}</a>
              </h2>
              <p>{c.data.dek}</p>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">The first column is coming soon.</p>
      )
    }

    <p class="bio">{COLUMN.authorBio} <a href="/about/#editor">More about the editor</a></p>
    <NewsletterForm />
  </div>
</Base>

<style>
  .narrow {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .list li {
    border-top: 1px solid var(--rule);
    padding: 1.2rem 0;
  }
  time {
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  h2 {
    font-size: 1.45rem;
    margin: 0.25rem 0 0.4rem;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  .list p,
  .empty {
    color: var(--ink-2);
    margin: 0;
  }
  .bio {
    font-size: 0.9rem;
    color: var(--ink-3);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin: 2rem 0;
  }
</style>
