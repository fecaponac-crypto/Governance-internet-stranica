// Cloudflare Workers deployment (Workers Builds runs `npm run build`, then `npx wrangler deploy`).
// Without this file `wrangler deploy` auto-configures the project (adds the Astro
// Cloudflare adapter and rebuilds), which breaks the build-time card renderer.
{
  "name": "governance-internet-stranica",
  // Handles email to sources@ (newsletters as sources) and requests with no matching asset.
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Worker logs in the dashboard (Observability), e.g. for the cron below.
  "observability": { "enabled": true },
  // Start GitHub workflows (UTC): ingestion every 3 hours, The Monday Signal on Mondays,
  // and the public launch (30 October 10:55, live at 12:00 Zagreb).
  // Keep in sync with CRON_JOBS in worker/index.js. Cloudflare counts weekdays 1 = Sunday,
  // so use names (MON), never numbers.
  "triggers": { "crons": ["17 */3 * * *", "47 5 * * MON", "55 10 30 10 *"] },
  // Private store for incoming newsletters; created automatically on first deploy.
  "kv_namespaces": [{ "binding": "SOURCES" }],
  // Monday traffic report to the editor (REPORT_EMAIL secret; only verified Email Routing destinations).
  "send_email": [{ "name": "REPORT_MAILER" }]
}
