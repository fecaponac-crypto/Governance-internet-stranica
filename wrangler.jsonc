// Cloudflare Workers deployment: serve the static site built by `npm run build`.
// Without this file `wrangler deploy` auto-configures the project (adds the Astro
// Cloudflare adapter and rebuilds), which breaks the build-time card renderer.
{
  "name": "governance-internet-stranica",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
